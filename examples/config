# whispr configuration -- copy to ~/.config/whispr/config
# Unknown keys are reported rather than ignored, so a typo is visible.

engine              = whisper           # whisper | parakeet
use_gpu             = true
gpu_device          = 0
n_threads           = 8

whisper.model       = ~/.local/share/whispr/models/ggml-base.en.bin
whisper.language    = en                # or "auto"
whisper.translate   = false

# Primes the decoder with terms it otherwise mangles. Measured on the test
# fixtures this takes jargon WER from 0.42 to 0.16 on base.en -- it is the
# cheapest accuracy lever available, so put your own vocabulary here.
whisper.initial_prompt = CachyOS, Hyprland, PipeWire, ydotool, whisper.cpp, Vulkan, systemd, Keychron

# Voice activity detection. Leave this on. Without it Whisper invents plausible
# text from room tone -- observed emitting "(dramatic music)", "Get a Clospe."
# and once "Fuck you!" from a silent room -- and whispr types it into whatever
# window has focus. Silero segments the audio first, so silence reaches the
# decoder as nothing at all.
whisper.vad         = true
whisper.vad_model   = ~/.local/share/whispr/models/ggml-silero-v5.1.2.bin

parakeet.model      = ~/.local/share/whispr/models/ggml-parakeet-tdt-0.6b-v3-f16.bin

# Empty means the default input device.
source              =

# A stuck push-to-talk is this tool's worst failure, so recording always stops
# on its own even if the key-release event is lost.
max_record_seconds  = 120

# Shorter than this is a stray tap, not dictation -- dropped silently.
min_record_ms       = 300

# Discard this much audio from the start of every recording. The start cue is
# played through the speakers while the microphone is already open, so whispr
# would otherwise record and transcribe its own beep -- VAD does not filter it,
# a beep being acoustically close enough to speech to survive. The cue is also
# your signal to start talking, so nothing intentional is lost here.
skip_start_ms       = 300

# Hands-free mode (the square key): stop this long after you stop talking.
# Raise it if you pause mid-thought and it cuts you off.
silence_stop_ms     = 2000

# Hands-free waits for speech before any silence counts, so a stray tap would
# otherwise hold the mic until max_record_seconds. Give up quietly after this.
dictate_wait_s      = 10

# Above this RMS counts as speech. Measured on this machine the room floor sits
# at -31.6 dB and speech at -20.7 to -14.3 dB, so -28 falls in the gap. Lower it
# if hands-free cuts off while you are still talking; raise it if a noisy room
# stops it from ever detecting silence (the max_record_seconds watchdog will
# still end the recording either way).
voice_dbfs          = -28.0

# Belt and braces below VAD: audio quieter than this never reaches the model.
min_rms_dbfs        = -50.0
max_no_speech       = 0.6

# Drop the model this long after the last utterance to give the memory back.
idle_unload_seconds = 600

append_space        = true
inject_cmd          = whispr-inject
# Typing speed is set in whispr-inject via WHISPR_TYPE_DELAY_MS (default 2) and
# WHISPR_TYPE_HOLD_MS (default 1). ydotool's own defaults are 20/20, which is
# 40ms per character -- nearly 4 seconds for one sentence.
notify_cmd          = whispr-notify
