[Unit]
Description=whispr voice dictation daemon
Documentation=https://github.com/dkenzik/popshat-whispr
# Injection needs a compositor to type into, so the service is tied to the
# graphical session rather than to login.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# The user manager's PATH omits ~/.local/bin, so the helpers whispr spawns
# (whispr-inject, whispr-notify) are not findable by name. The daemon also
# falls back to its own directory, but fixing PATH keeps a user-edited
# inject_cmd working too.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/whispr daemon
Restart=on-failure
RestartSec=2
# The model is loaded lazily and dropped when idle, so the resident footprint
# between utterances is small.
Nice=-5

[Install]
WantedBy=graphical-session.target
